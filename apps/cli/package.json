{
  "name": "@ferry/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ferry": "./dist/ferry.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test tsup.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ferry/client": "workspace:*",
    "@ferry/core": "workspace:*",
    "@ferry/delegate": "workspace:*",
    "@ferry/shared": "workspace:*",
    "@napi-rs/keyring": "2.1.0",
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "13.0.3",
    "citty": "0.2.2",
    "cli-highlight": "2.1.11",
    "ink": "7.1.1",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "marked": "18.0.14",
    "node-pty": "1.1.0",
    "pino": "10.3.1",
    "pino-roll": "4.0.0",
    "react": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ferry/testkit": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "8.5.1"
  }
}
