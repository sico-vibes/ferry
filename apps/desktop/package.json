{
  "name": "@ferry/desktop",
  "version": "0.1.0-mock",
  "private": true,
  "type": "module",
  "description": "Ferry desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint src *.config.ts",
    "test": "vitest run",
    "shot": "node scripts/shot.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@ferry/client": "workspace:*",
    "@ferry/shared": "workspace:*",
    "@ferry/ui": "workspace:*",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-virtual": "3.14.13",
    "lucide-react": "1.47.0",
    "motion": "13.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6"
  }
}
