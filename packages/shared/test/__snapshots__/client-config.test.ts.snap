exports[`shared client configuration > generates bash curl with literal-safe quoting 1`] = `
"curl 'http://127.0.0.1:11435/v1/chat/completions' \\
  -H 'Authorization: Bearer YOUR_FERRY_KEY' \\
  -H 'Content-Type: application/json' \\
  --data-raw '{"model":"ferry/auto","messages":[{"role":"user","content":"Hello"}]}'"
`;

