{
  "name": "@ferry/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ignore-pattern build/** --ignore-pattern scripts/** --ignore-pattern .ladle/config.mjs",
    "test": "vitest run",
    "gallery": "ladle serve --port 61000",
    "gallery:build": "ladle build",
    "shot:gallery": "node scripts/shot-gallery.mjs",
    "test:contrast": "node scripts/audit-light-contrast.mjs"
  },
  "dependencies": {
    "@ferry/shared": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@ladle/react": "5.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.47.0",
    "motion": "13.4.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "simple-icons": "16.32.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1"
  }
}
