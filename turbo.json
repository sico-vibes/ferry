{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["FERRY_KEYRING_SERVICE", "FERRY_TEST_KEYRING_NAMESPACE", "FERRY_BROWSER_PATH"],
  "tasks": {
    "typecheck": { "dependsOn": ["^typecheck"] },
    "lint": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "test": { "outputs": [] },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "out/**"] },
    "dev": { "cache": false, "persistent": true }
  }
}
